# Where the media service is listening.
VITE_MEDIA_API_URL=http://localhost:8001

# Who the audit trail records for decisions taken from this browser. A claim, not an
# authenticated identity: the service trusts this header while OPERATOR_AUTH_MODE=none.
# Letters, digits, and . _ @ + - only, at most 64 characters.
VITE_OPERATOR_ID=portal-operator
